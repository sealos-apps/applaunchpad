{
  "name": "applaunchpad",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "gen:theme-typings": "pnpm chakra-cli tokens node_modules/@labring/sealos-chakra-ui/src/theme/theme.ts --out node_modules/.pnpm/node_modules/@chakra-ui/styled-system/dist/theming.types.d.ts",
    "postinstall": "pnpm run gen:theme-typings",
    "dev": "pnpm run config:gen-json-schema && next dev",
    "config:gen-json-schema": "pnpm --silent dlx tsx -e \"import { z } from 'zod'; import { AppConfigSchema as s } from './src/types/config'; console.log(JSON.stringify(z.toJSONSchema(s)));\" > ./data/config.schema.json",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:unit": "vitest run __tests__/unit",
    "test:components": "vitest --project components",
    "test:components:ci": "vitest run --project components",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@chakra-ui/anatomy": "^2.2.1",
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/next-js": "^2.1.5",
    "@chakra-ui/react": "^2.8.1",
    "@chakra-ui/system": "^2.6.1",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@kubernetes/client-node": "^0.18.1",
    "@labring/sealos-metrics-sdk": "0.2.0",
    "@scalar/api-reference-react": "^0.8.36",
    "@labring/sealos-driver-sdk": "1.0.0",
    "@labring/sealos-gtm-sdk": "1.1.0",
    "@labring/sealos-ui": "1.0.2",
    "@labring/sealos-shared-sdk": "1.0.3",
    "@labring/sealos-chakra-ui": "1.0.0",
    "@tanstack/react-query": "^4.35.3",
    "@tanstack/react-table": "^8.10.7",
    "@types/jsonwebtoken": "^9.0.3",
    "ansi_up": "^5.2.1",
    "axios": "^1.5.1",
    "base64-stream": "^1.0.0",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.10",
    "decimal.js": "^10.4.3",
    "dns": "^0.2.2",
    "dns-packet": "^5.6.1",
    "echarts": "^5.4.3",
    "fast-json-patch": "^3.1.1",
    "formidable": "^3.5.1",
    "framer-motion": "^10.16.4",
    "i18next": "^23.11.5",
    "immer": "^9.0.21",
    "js-base64": "^3.7.7",
    "js-cookie": "^3.0.5",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.476.0",
    "nanoid": "^4.0.2",
    "next": "14.2.35",
    "next-i18next": "^15.3.0",
    "nprogress": "^0.2.0",
    "prettier": "^2.8.8",
    "react": "18.3.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.46.2",
    "react-i18next": "^14.1.2",
    "react-markdown": "^8.0.7",
    "react-syntax-highlighter": "^15.5.0",
    "sass": "^1.68.0",
    "@labring/sealos-desktop-sdk": "0.1.24",
    "sonner": "^2.0.0",
    "typescript": "^5.2.2",
    "zod": "^4.3.5",
    "zod-openapi": "^4.2.4",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^2.4.1",
    "@svgr/webpack": "^6.5.1",
    "@tailwindcss/postcss": "^4.1.10",
    "tailwindcss": "^4.1.10",
    "geist": "^1.4.2",
    "@vitest/browser": "4.0.15",
    "@vitest/browser-playwright": "4.0.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^14.0.0",
    "@types/base64-stream": "^1.0.5",
    "@types/dns-packet": "^5.6.5",
    "@types/formidable": "^3.4.5",
    "@types/js-cookie": "^3.0.4",
    "@types/js-yaml": "^4.0.6",
    "@types/lodash": "^4.14.199",
    "@types/node": "18.13.0",
    "@types/nprogress": "^0.2.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/react-syntax-highlighter": "^15.5.7",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "4.0.12",
    "eslint": "8.33.0",
    "eslint-config-next": "13.5.9",
    "jsdom": "^27.2.0",
    "svg-inline-loader": "^0.8.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.12",
    "webpack-bundle-analyzer": "^4.9.1",
    "tw-animate-css": "^1.3.4"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "win32",
        "darwin",
        "current",
        "linuxmusl"
      ],
      "cpu": [
        "x64",
        "arm64"
      ],
      "libc": [
        "musl"
      ]
    }
  },
  "packageManager": "pnpm@8.9.0",
  "engines": {
    "node": "20.20.2",
    "pnpm": "8.9.0"
  }
}
