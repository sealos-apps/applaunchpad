# Runtime configuration is YAML, not environment variables.
# Development: copy data/config.example.yaml to data/config.local.yaml and edit it.
# Legacy data/config.yaml.local is used only if config.local.yaml is absent.
# Production: Helm renders applaunchpadConfig into /app/data/config.yaml.
# Override with: helm upgrade ... -f operator-values.yaml
# Optional capabilities and defaults:
# applaunchpadConfig.nodePortHost="" (public NodePort host; empty disables new access)
# applaunchpadConfig.networkStorageEnabled=false (mount existing shared PVCs)
# applaunchpadConfig.imagePortsEnabled=false (discover image ports)
# applaunchpadConfig.imagePortsTrustedRegistries=[] (trusted registry allowlist)
# applaunchpadConfig.customPublicDomainPrefixEnabled=false (custom public prefix)
# applaunchpadConfig.publicDomainReservedPrefixes=[] (reserved public prefixes)
# applaunchpadConfig.customDomainMode=cname (cname or certificate)
# applaunchpadConfig.customDomainCertificateSecretName=wildcard-cert
# certificateRbac.enabled=false (certificate mode cross-namespace read permissions)
# serviceAccount.create=true; serviceAccount.name=applaunchpad-frontend
# applaunchpadConfig.guideEnabled/apiEnabled/gpuEnabled=false
# applaunchpadConfig.pvcStorageMax=100 (Gi per local PVC)
# applaunchpadConfig.fileManger.uploadLimit=50/downloadLimit=100 (MiB)
# applaunchpadConfig.appResourceFormSliderConfig controls CPU/memory/ephemeral storage choices.
# TLS verification is enabled by default. Helm override: applaunchpadConfig.tlsRejectUnauthorized.
NODE_TLS_REJECT_UNAUTHORIZED=1
# applaunchpadConfig.requiresDomainReg=false (ICP registration policy; explicit values override installer detection)
# applaunchpadConfig.domainChallengeSecret=default-dev-secret-change-in-production (set a private production value)
# gpuEnabled=true also installs read-only access to node-system/node-gpu-info; that namespace must exist.
# Installer-only environment (not frontend runtime):
# RELEASE_NAME=applaunchpad-frontend; RELEASE_NAMESPACE=applaunchpad-frontend
# CHART_PATH=./charts/applaunchpad-frontend
# TOOLS_FILE=/root/.sealos/cloud/scripts/tools.sh (optional platform configuration integration)
# HELM_OPTIONS / HELM_OPTS: additional Helm arguments; use -f files for values containing spaces.
# SEALOS_CLOUD_DOMAIN/cloudDomain, SEALOS_CLOUD_PORT/cloudPort, SEALOS_HTTP_PORT/httpPort,
# SEALOS_DISABLE_HTTPS/disableHttps, SEALOS_CERT_SECRET_NAME/certSecretName:
# installer fallbacks when sealos-system/sealos-config is absent; chart defaults apply when unset.
# monitorUrl, billingUrl, logUrl, tlsRejectUnauthorized: optional installer overrides of chart defaults.
# Config precedence: chart defaults < detected settings < operator values < HELM_OPTIONS < HELM_OPTS.
# When platform tools are available, the cluster TLS policy is enforced last.
# Helm GPU slider defaults use defaultGPU for legacy overrides; runtime normalizes to default-gpu.
